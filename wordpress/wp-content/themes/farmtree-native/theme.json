{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "farmtree-green",
          "name": "FarmTree Green",
          "color": "#00613F"
        },
        {
          "slug": "farmtree-forest",
          "name": "FarmTree Forest",
          "color": "#00613F"
        },
        {
          "slug": "farmtree-ink",
          "name": "FarmTree Ink",
          "color": "#163126"
        },
        {
          "slug": "farmtree-ivory",
          "name": "FarmTree Ivory",
          "color": "#FAF8F1"
        },
        {
          "slug": "farmtree-cream",
          "name": "FarmTree Cream",
          "color": "#F5F1E8"
        },
        {
          "slug": "farmtree-mist",
          "name": "FarmTree Mist",
          "color": "#DCE7D2"
        },
        {
          "slug": "farmtree-gold",
          "name": "FarmTree Gold",
          "color": "#D3B06B"
        },
        {
          "slug": "farmtree-sky",
          "name": "FarmTree Sky",
          "color": "#F5F0E4"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        }
      ]
    },
    "dimensions": {
      "minHeight": true
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "S",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "M",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "L",
          "size": "1.625rem"
        },
        {
          "slug": "60",
          "name": "XL",
          "size": "2.25rem"
        },
        {
          "slug": "70",
          "name": "2XL",
          "size": "clamp(3.5rem, 6vw, 5.5rem)"
        },
        {
          "slug": "80",
          "name": "3XL",
          "size": "clamp(4.5rem, 8vw, 7rem)"
        }
      ],
      "units": [
        "px",
        "rem",
        "%"
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "editorial",
          "name": "FarmTree Editorial",
          "fontFamily": "Manrope, Inter, system-ui, sans-serif"
        },
        {
          "slug": "interface",
          "name": "FarmTree Interface",
          "fontFamily": "Inter, system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "caption",
          "name": "Caption",
          "size": "0.8125rem"
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "1rem"
        },
        {
          "slug": "lead",
          "name": "Lead",
          "size": "1.125rem"
        },
        {
          "slug": "heading-small",
          "name": "Heading Small",
          "size": "2.875rem"
        },
        {
          "slug": "heading",
          "name": "Heading",
          "size": "4.75rem"
        }
      ],
      "fontStyle": false,
      "fontWeight": true,
      "letterSpacing": false,
      "lineHeight": true,
      "textDecoration": false,
      "textTransform": false,
      "writingMode": false
    },
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "soft",
          "name": "Soft",
          "shadow": "0 18px 48px rgb(22 49 38 / 10%)"
        }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": false
        },
        "color": {
          "custom": false,
          "customGradient": false
        },
        "spacing": {
          "padding": false
        }
      },
      "core/group": {
        "color": {
          "custom": false
        }
      },
      "core/heading": {
        "typography": {
          "fontSize": false
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": false
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|farmtree-cream",
      "text": "var:preset|color|farmtree-ink"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|50",
      "padding": {
        "left": "var:preset|spacing|50",
        "right": "var:preset|spacing|50"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|interface",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var:preset|color|farmtree-forest",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "right": "1.625rem",
            "bottom": "0.95rem",
            "left": "1.625rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|editorial",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "800"
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|farmtree-green"
        },
        "typography": {
          "fontSize": "var:preset|font-size|caption"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial",
          "fontWeight": "800",
          "lineHeight": "1.08"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|farmtree-green"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      }
    },
    "blocks": {
      "core/post-content": {
        "spacing": {
          "blockGap": "var:preset|spacing|60"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var:preset|font-size|heading"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "FarmTree Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "FarmTree Footer",
      "area": "footer"
    },
    {
      "name": "quotation-modal",
      "title": "FarmTree Quotation Modal",
      "area": "uncategorized"
    }
  ],
  "customTemplates": [
    {
      "name": "content-only-page",
      "title": "FarmTree Content-Only Page",
      "postTypes": [
        "page"
      ]
    }
  ]
}
